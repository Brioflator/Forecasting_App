# worker service image — scheduler + poller + dispatch + relay (doc 1 §4.0)
FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /uvx /bin/

ENV UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1
WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY shared/pyproject.toml shared/
COPY services/api/pyproject.toml services/api/
COPY services/worker/pyproject.toml services/worker/
COPY services/ml/pyproject.toml services/ml/
RUN uv sync --frozen --no-install-workspace --no-dev --package forecast-worker

COPY shared/ shared/
COPY services/worker/ services/worker/
RUN uv sync --frozen --no-dev --package forecast-worker

CMD ["uv", "run", "--no-sync", "python", "-m", "worker.main"]
